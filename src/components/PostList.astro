---
import type { CollectionEntry } from 'astro:content';

interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const formatter = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a class="post-card" href={`/blog/${post.id}/`}>
        <p class="eyebrow">文章</p>
        <h3>{post.data.title}</h3>
        <p class="post-card-description">{post.data.description}</p>
        <div class="post-meta">
          <time datetime={post.data.publishDate.toISOString()}>{formatter.format(post.data.publishDate)}</time>
          {post.data.tags && <span class="tags">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</span>}
        </div>
      </a>
    </li>
  ))}
</ul>
